# 기본 연결 정보는 src/lib/supabase/env.ts 에 들어 있어요. 다른 Supabase 프로젝트를 쓸 때만 채우세요.
# 로컬: 이 파일을 .env.local 로 복사 / Vercel: Project Settings → Environment Variables 에 같은 이름으로 추가
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 게시판 번역 (선택): DeepL API 키. 없으면 번역 버튼이 안 보여요.
# DeepL 계정 → API Keys 에서 복사해서 Vercel 환경 변수에만 넣으세요 (코드·채팅에 붙여넣지 마세요)
DEEPL_API_KEY=
